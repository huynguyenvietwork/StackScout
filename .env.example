# Copy to .env and fill in what you use. Everything is optional except an AI backend.

# ---- AI backend (pick one)
# 1) Anthropic API key: used automatically when set (required in Docker).
# ANTHROPIC_API_KEY=
# STACKSCOUT_MODEL=claude-opus-5-5     # any Claude model id
# STACKSCOUT_EFFORT=medium             # low | medium | high
# 2) A headless AI CLI that reads the prompt on stdin (default: claude -p, already logged in).
# STACKSCOUT_AI_CMD=
# Force one: STACKSCOUT_AI_BACKEND=api | cli

# ---- Weekly digest delivery (configure any number of channels)
# Telegram: bot token from @BotFather; the web profile's digest goes to this chat (your user id).
# TELEGRAM_BOT_TOKEN=
# STACKSCOUT_TELEGRAM_CHAT_ID=
# Email (SMTP). Port 465 uses SSL, otherwise STARTTLS (SMTP_SECURITY=ssl|starttls|none).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# STACKSCOUT_EMAIL_TO=
# Slack incoming webhook / Discord webhook / any JSON webhook (n8n, Zapier, Make...)
# STACKSCOUT_SLACK_WEBHOOK_URL=
# STACKSCOUT_DISCORD_WEBHOOK_URL=
# STACKSCOUT_WEBHOOK_URL=
# When `main.py schedule` (Docker) sends the digest, in the server's local time.
# STACKSCOUT_DIGEST_DAY=mon
# STACKSCOUT_DIGEST_TIME=08:00

# ---- Telegram bot (optional)
# Comma-separated Telegram user ids allowed to use the bot. Leave empty only for
# testing: every request costs an AI call on your account. Find your id with @userinfobot.
STACKSCOUT_ALLOWED_USERS=

# ---- Storage and sources
# Where profiles, source lists and reports are stored (default: ./data and ./reports)
# STACKSCOUT_DATA_DIR=
# STACKSCOUT_REPORTS_DIR=
# Optional: raises the GitHub search API rate limit for "new repos".
# GITHUB_TOKEN=
